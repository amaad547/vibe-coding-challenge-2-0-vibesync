# ==============================================================================
# SportSync Environment Variables Template
# Copy this file to .env.local for local development.
# In production (Vercel), add these keys to Project Settings > Environment Variables.
# NEVER COMMIT REAL SECRETS TO SOURCE CONTROL.
# ==============================================================================

# [Required] MongoDB Atlas Connection String
# Must include username, password, cluster hostname, and database name.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-id>.mongodb.net/dumka_desk?retryWrites=true&w=majority

# [Required] Authentication Secret for JWT session tokens (Minimum 32 characters)
# Generate a cryptographically secure key: `openssl rand -base64 32`
AUTH_SECRET=your_minimum_32_character_cryptographically_secure_secret_key_here

# [Required in Prod] Application Base URL (no trailing slash)
APP_BASE_URL=http://localhost:3000

# [Optional] Node Environment (development | production | test)
NODE_ENV=development

# [Optional] Provisioning Seed Credentials (used by `npm run seed`)
INITIAL_COACH_EMAIL=coach@dumkasports.org
INITIAL_COACH_PASSWORD=coach@dumka123
INITIAL_COACH_NAME=Dumka Head Coach
INITIAL_SCOUT_EMAIL=scout@dumkasports.org
INITIAL_SCOUT_PASSWORD=scout@sport123
