# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/dumka_desk?retryWrites=true&w=majority

# Authentication secret for encrypting session cookies (min 32 characters)
AUTH_SECRET=your_minimum_32_character_random_secret_key_here_123456

# Application base URL
